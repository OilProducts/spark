{
  "schema_version": "2",
  "id": "editor_smoke_base",
  "title": "Editor Smoke Base",
  "description": "Exercise editor and execution smoke-test surfaces without relying on shipped example flows.",
  "goal": "Exercise editor and execution smoke-test surfaces without relying on shipped example flows.",
  "defaults": {
    "llm_provider": "openai",
    "llm_model": "gpt-5.3-codex-spark"
  },
  "nodes": {
    "start": {
      "kind": "start",
      "label": "Start",
      "config": {
        "kind": "start"
      },
      "routes": {
        "next": {
          "to": "ingest_spec",
          "description": "Enter the first workflow step."
        }
      }
    },
    "ingest_spec": {
      "kind": "agent_task",
      "label": "Ingest Spec",
      "config": {
        "kind": "agent_task",
        "prompt": "Load the test spec source and prepare working state."
      },
      "contracts": {
        "response": "decision_envelope"
      },
      "routes": {
        "done": {
          "to": "extract_declarations",
          "description": "The spec source is loaded and working state is prepared."
        }
      }
    },
    "extract_declarations": {
      "kind": "agent_task",
      "label": "Extract Testable Declarations",
      "config": {
        "kind": "agent_task",
        "prompt": "Inspect the repository and write a bounded set of testable declarations."
      },
      "contracts": {
        "response": "decision_envelope"
      },
      "routes": {
        "done": {
          "to": "audit_human_gate",
          "description": "The testable declarations are written."
        }
      }
    },
    "audit_human_gate": {
      "kind": "human_gate",
      "label": "Human Audit Decision",
      "config": {
        "kind": "human_gate",
        "prompt": "Choose whether to rework or accept risk."
      },
      "routes": {
        "rework": {
          "to": "audit_rework",
          "label": "Rework Queue State",
          "description": "The queued work needs rework."
        },
        "accept_risk": {
          "to": "done",
          "label": "Accept Risk",
          "description": "The remaining risk is accepted."
        }
      }
    },
    "audit_rework": {
      "kind": "agent_task",
      "label": "Rework Queue State",
      "config": {
        "kind": "agent_task",
        "prompt": "Repair the queued work and continue."
      },
      "contracts": {
        "response": "decision_envelope"
      },
      "routes": {
        "done": {
          "to": "done",
          "description": "The queued work is repaired."
        }
      }
    },
    "done": {
      "kind": "exit",
      "label": "Done",
      "config": {
        "kind": "exit",
        "result": {
          "name": "completed",
          "outcome": "success"
        }
      }
    }
  }
}
