{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "ExecutionConfig": {
      "additionalProperties": false,
      "properties": {
        "llm_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "llm_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "llm_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasoning_effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasoning_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasoning_summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "thinking": {
          "type": [
            "string",
            "null"
          ]
        },
        "thinking_budget_tokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ExitOutcome": {
      "enum": [
        "success",
        "failure"
      ],
      "type": "string"
    },
    "ExitResult": {
      "additionalProperties": false,
      "description": "An exit's declared terminal result.",
      "properties": {
        "name": {
          "type": "string"
        },
        "outcome": {
          "$ref": "#/definitions/ExitOutcome"
        }
      },
      "required": [
        "name",
        "outcome"
      ],
      "type": "object"
    },
    "FlowDefaults": {
      "additionalProperties": false,
      "properties": {
        "extensions": {
          "additionalProperties": true,
          "type": "object"
        },
        "llm_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "llm_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "llm_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_retries": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "reasoning_effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasoning_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasoning_summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "thinking": {
          "type": [
            "string",
            "null"
          ]
        },
        "thinking_budget_tokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "FlowExecutionLock": {
      "additionalProperties": false,
      "description": "A flow's execution lock (`execution_lock` in `flow.md`). Scope `project` resolves identity from the repository containing the working directory, so linked git worktrees share one lock; `conflict_policy` is `queue`.",
      "properties": {
        "conflict_policy": {
          "default": "queue",
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "scope"
      ],
      "type": "object"
    },
    "FlowInput": {
      "additionalProperties": false,
      "properties": {
        "default": true,
        "description": {
          "default": "",
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "label": {
          "default": "",
          "type": "string"
        },
        "required": {
          "default": false,
          "type": "boolean"
        },
        "type": {
          "default": "string",
          "type": "string"
        }
      },
      "required": [
        "key"
      ],
      "type": "object"
    },
    "FlowNode": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "anyOf": [
            {
              "$ref": "#/definitions/NodeConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "context": {
          "additionalProperties": true,
          "type": "object"
        },
        "contracts": {
          "anyOf": [
            {
              "$ref": "#/definitions/NodeContracts"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "execution": {
          "anyOf": [
            {
              "$ref": "#/definitions/ExecutionConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "extensions": {
          "additionalProperties": true,
          "type": "object"
        },
        "kind": {
          "$ref": "#/definitions/NodeKind"
        },
        "label": {
          "default": "",
          "type": "string"
        },
        "manager": {
          "anyOf": [
            {
              "$ref": "#/definitions/ManagerLoopConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "retry": {
          "anyOf": [
            {
              "$ref": "#/definitions/RetryConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "description": "Role file (`roles/<name>.md`) whose persona and execution defaults the loader merges into this `agent_task` node. Only the authored form sets it.",
          "type": [
            "string",
            "null"
          ]
        },
        "routes": {
          "additionalProperties": {
            "$ref": "#/definitions/FlowRoute"
          },
          "description": "The node's complete decision vocabulary: each decision ID and the one route it selects. Edges are derived from this map.",
          "type": "object"
        },
        "runtime": {
          "anyOf": [
            {
              "$ref": "#/definitions/NodeRuntimeConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "ui": {
          "anyOf": [
            {
              "$ref": "#/definitions/UiConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "FlowRoute": {
      "additionalProperties": false,
      "description": "One declared decision: its target and what choosing it means. `label` is display text only; it has no routing authority.",
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        },
        "extensions": {
          "additionalProperties": true,
          "description": "Presentation metadata, such as canvas layout hints.",
          "type": "object"
        },
        "label": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "to"
      ],
      "type": "object"
    },
    "ManagerLoopConfig": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "child_autostart": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "child_workdir": {
          "type": [
            "string",
            "null"
          ]
        },
        "child_workdir_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_cycles": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "poll_interval": {
          "type": [
            "string",
            "null"
          ]
        },
        "steer_cooldown": {
          "type": [
            "string",
            "null"
          ]
        },
        "stop_condition": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "NodeConfig": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "start"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "exit"
              ],
              "type": "string"
            },
            "result": {
              "$ref": "#/definitions/ExitResult"
            },
            "result_summary": {
              "description": "When true, reaching this exit produces the run result by pointing a summarizer agent at the run's recorded transcripts and artifacts. Failed runs use the first opted-in exit by node ID.",
              "type": "boolean"
            },
            "result_summary_prompt": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "result"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "agent_task"
              ],
              "type": "string"
            },
            "prompt": {
              "default": "",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "human_gate"
              ],
              "type": "string"
            },
            "prompt": {
              "default": "",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Selects a declared decision by comparing one context value with JSON scalar case keys (`\"0\"` is number 0, `'\"0\"'` is string \"0\").",
          "properties": {
            "cases": {
              "additionalProperties": {
                "type": "string"
              },
              "default": {},
              "type": "object"
            },
            "kind": {
              "enum": [
                "switch"
              ],
              "type": "string"
            },
            "on": {
              "type": "string"
            },
            "otherwise": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "on",
            "otherwise"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "branches": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "join": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "parallel"
              ],
              "type": "string"
            },
            "max_parallel": {
              "format": "uint64",
              "minimum": 0.0,
              "type": [
                "integer",
                "null"
              ]
            },
            "tolerate_branch_execution_errors": {
              "description": "Keep a branch that ended with a tolerable execution error and still enter the join; fatal conditions always fail the owner.",
              "type": "boolean"
            }
          },
          "required": [
            "branches",
            "join",
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "fan_in"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "command": {
              "default": "",
              "type": "string"
            },
            "decision_field": {
              "description": "JSON adapter: the named top-level field of the tool's single JSON stdout object is the decision.",
              "type": [
                "string",
                "null"
              ]
            },
            "env_map": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "exit_codes": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "Exit-code adapter: each listed code (a decimal integer key) selects a declared decision.",
              "type": "object"
            },
            "kind": {
              "enum": [
                "tool"
              ],
              "type": "string"
            },
            "output_map": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "flow_ref": {
              "type": "string"
            },
            "input_map": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "kind": {
              "enum": [
                "subflow"
              ],
              "type": "string"
            },
            "output_map": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "Child context keys copied into the parent (`child_key: parent_key`) when the child run ends; an absent child key clears the parent key.",
              "type": "object"
            },
            "results": {
              "additionalProperties": {
                "type": "string"
              },
              "default": {},
              "description": "Child terminal result name -> local decision.",
              "type": "object"
            }
          },
          "required": [
            "flow_ref",
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "NodeContracts": {
      "additionalProperties": false,
      "properties": {
        "reads_context": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "repair_attempts": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "response": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "writes_context": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "NodeKind": {
      "enum": [
        "start",
        "exit",
        "agent_task",
        "human_gate",
        "switch",
        "parallel",
        "fan_in",
        "tool",
        "subflow"
      ],
      "type": "string"
    },
    "NodeRuntimeConfig": {
      "additionalProperties": false,
      "properties": {
        "class": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_visits": {
          "description": "Maximum number of times a transition may enter this node within one run (or one branch invocation). A decision selecting an exhausted target fails with `visit_limit_reached`. Absent means the engine default.",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "recovery_policy": {
          "allOf": [
            {
              "$ref": "#/definitions/RecoveryPolicy"
            }
          ],
          "description": "Behavior when this node was started but not checkpointed before a restart."
        },
        "session": {
          "description": "Named session (`session: <name>`) this agent_task node continues. Nodes sharing a name continue one provider session; absent means a fresh session.",
          "type": [
            "string",
            "null"
          ]
        },
        "timeout": {
          "description": "Maximum node execution time, in seconds or as a duration such as `90s`, `15m` or `2h`. Agent and tool nodes past it fail.",
          "type": [
            "string",
            "null"
          ]
        },
        "workdir_from": {
          "description": "Context key (`workdir_from: context.workspace.path`) naming the directory this agent_task node's agent runs in; same rules as `manager.child_workdir_from`. Absent means the run's working directory.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "RecoveryPolicy": {
      "enum": [
        "rerun",
        "pause"
      ],
      "type": "string"
    },
    "RetryConfig": {
      "additionalProperties": false,
      "properties": {
        "max_retries": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "policy": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "UiConfig": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "y": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "properties": {
    "defaults": {
      "$ref": "#/definitions/FlowDefaults"
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "execution_lock": {
      "anyOf": [
        {
          "$ref": "#/definitions/FlowExecutionLock"
        },
        {
          "type": "null"
        }
      ],
      "description": "Runs of flows sharing a lock identity queue and execute one at a time."
    },
    "extensions": {
      "additionalProperties": true,
      "type": "object"
    },
    "goal": {
      "default": "",
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "inputs": {
      "items": {
        "$ref": "#/definitions/FlowInput"
      },
      "type": "array"
    },
    "metadata": {
      "additionalProperties": true,
      "type": "object"
    },
    "nodes": {
      "additionalProperties": {
        "$ref": "#/definitions/FlowNode"
      },
      "default": {},
      "type": "object"
    },
    "schema_version": {
      "type": "string"
    },
    "title": {
      "default": "",
      "type": "string"
    }
  },
  "required": [
    "id",
    "schema_version"
  ],
  "title": "FlowDefinition",
  "type": "object"
}
